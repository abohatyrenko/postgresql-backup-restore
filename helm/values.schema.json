{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "postgresql-backup-restore values",
  "description": "Unknown keys are rejected, so a typo in a value name fails the install instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string" },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
        "startingDeadlineSeconds": { "$ref": "#/definitions/optionalSeconds" },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "$ref": "#/definitions/optionalSeconds" },
        "ttlSecondsAfterFinished": { "$ref": "#/definitions/optionalSeconds" },
        "args": { "$ref": "#/definitions/args" },
        "passwordSecret": { "$ref": "#/definitions/passwordSecret" },
        "env": { "$ref": "#/definitions/env" }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "$ref": "#/definitions/optionalSeconds" },
        "ttlSecondsAfterFinished": { "$ref": "#/definitions/optionalSeconds" },
        "args": { "$ref": "#/definitions/args" },
        "passwordSecret": { "$ref": "#/definitions/passwordSecret" },
        "env": { "$ref": "#/definitions/env" }
      }
    },
    "env": { "$ref": "#/definitions/env" },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "existingSecret": { "type": "string" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AWS_ACCESS_KEY_ID": { "type": "string" },
        "AWS_SECRET_ACCESS_KEY": { "type": "string" },
        "BACKUP_PASSWORD": { "type": "string" },
        "RESTORE_PASSWORD": { "type": "string" },
        "AGE_IDENTITY": { "type": "string" },
        "SLACK_WEBHOOK_URL": { "type": "string" }
      }
    },
    "workDir": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": { "type": "string", "minLength": 1 },
        "volume": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "deployNotification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "env": {
      "description": "Environment variables: name -> value",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "args": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "passwordSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "optionalSeconds": {
      "description": "null or 0 leaves the field out",
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
